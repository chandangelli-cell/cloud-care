# CloudCare Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-32-character-secret-key

# Database Configuration (PostgreSQL on Render / Supabase / AWS RDS, or SQLite local)
# Render Managed PostgreSQL Example (Render sets this automatically):
DATABASE_URL=postgresql://cloudadmin:password@dpg-xxxxxx.oregon-postgres.render.com/cloudcare_db
# Local SQLite fallback:
# DATABASE_URL=sqlite:///cloudcare.db

# Storage Provider Configuration: 'local', 'aws_s3', or 'azure_blob'
STORAGE_PROVIDER=local
UPLOAD_FOLDER=uploads

# AWS S3 / Cloudflare R2 / Supabase S3 Configuration (if STORAGE_PROVIDER=aws_s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=cloudcare-medical-reports

# Azure Blob Configuration (if STORAGE_PROVIDER=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=cloudcare-reports

# Hospital Settings
HOSPITAL_NAME=CloudCare Smart Hospital
HOSPITAL_TIMEZONE=UTC
PORT=5000
